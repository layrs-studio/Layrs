{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layrs.dev/schemas/sync-v3/receipt.schema.json",
  "title": "Layrs Sync V3 transaction receipt",
  "description": "Closed persisted semantic result. Storage integrity digest is BLAKE3('layrs.sync.v3/receipt' || NUL || exact JCS of this complete object) and is not a wire field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "type", "principalId", "authorizationEpoch", "resultingAuthorizationEpoch", "authorizationSnapshotId", "currentPolicySetId", "spaceId", "clientId", "idempotencyKey", "requestDigest", "transactionId", "status", "acceptedStepIds", "acceptedObservationIds", "acceptedRepositoryViewIds", "acceptedPolicySetIds", "acceptedProducts", "viewResult", "policyRootResult", "policyDecisions", "rejections", "eventIds", "firstEventSequence", "lastEventSequence", "eventCursor", "storedAt"],
  "properties": {
    "protocol": { "const": "layrs.sync.v3" },
    "type": { "const": "syncTransactionReceipt" },
    "principalId": { "$ref": "common.schema.json#/$defs/PrincipalId" },
    "authorizationEpoch": { "type": "integer", "minimum": 1 },
    "resultingAuthorizationEpoch": { "type": "integer", "minimum": 1 },
    "authorizationSnapshotId": { "$ref": "common.schema.json#/$defs/ContentId" },
    "currentPolicySetId": { "$ref": "common.schema.json#/$defs/ContentId" },
    "spaceId": { "$ref": "common.schema.json#/$defs/SpaceId" },
    "clientId": { "$ref": "common.schema.json#/$defs/ClientId" },
    "idempotencyKey": { "$ref": "common.schema.json#/$defs/IdempotencyKey" },
    "requestDigest": { "$ref": "common.schema.json#/$defs/ContentId" },
    "transactionId": { "$ref": "common.schema.json#/$defs/TransactionId" },
    "status": { "type": "string", "enum": ["applied", "rejected"] },
    "acceptedStepIds": { "$ref": "common.schema.json#/$defs/StepIdSet" },
    "acceptedObservationIds": {
      "type": "array", "maxItems": 10000, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/ObservationId" }
    },
    "acceptedRepositoryViewIds": {
      "type": "array", "maxItems": 4, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/RepositoryViewId" }
    },
    "acceptedPolicySetIds": {
      "type": "array", "maxItems": 2, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/ContentId" }
    },
    "acceptedProducts": {
      "type": "array", "maxItems": 10000, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/ProductRoot" }
    },
    "viewResult": {
      "oneOf": [{ "$ref": "#/$defs/RepositoryViewResult" }, { "type": "null" }]
    },
    "policyRootResult": {
      "oneOf": [{ "$ref": "#/$defs/PolicyRootResult" }, { "type": "null" }]
    },
    "policyDecisions": {
      "type": "array", "maxItems": 10000, "uniqueItems": true,
      "items": { "$ref": "#/$defs/PolicyDecision" }
    },
    "rejections": {
      "type": "array", "maxItems": 10000, "uniqueItems": true,
      "items": { "$ref": "#/$defs/Rejection" }
    },
    "eventIds": {
      "type": "array", "maxItems": 12000, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/EventId" }
    },
    "firstEventSequence": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "lastEventSequence": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "eventCursor": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Cursor" }, { "type": "null" }] },
    "storedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "applied" } }, "required": ["status"] },
      "then": { "properties": { "eventCursor": { "$ref": "common.schema.json#/$defs/Cursor" }, "rejections": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
      "then": {
        "properties": {
          "acceptedStepIds": { "maxItems": 0 },
          "acceptedObservationIds": { "maxItems": 0 },
          "acceptedRepositoryViewIds": { "maxItems": 0 },
          "acceptedPolicySetIds": { "maxItems": 0 },
          "acceptedProducts": { "maxItems": 0 },
          "viewResult": { "type": "null" },
          "policyRootResult": { "type": "null" },
          "eventIds": { "maxItems": 0 },
          "firstEventSequence": { "type": "null" },
          "lastEventSequence": { "type": "null" },
          "eventCursor": { "type": "null" },
          "rejections": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "LayerMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerId", "mode", "previousHeads", "proposedHeads", "resultingHeads", "divergenceCreated", "decisionProductObjectId"],
      "properties": {
        "layerId": { "$ref": "common.schema.json#/$defs/LayerId" },
        "mode": { "type": "string", "enum": ["advance", "integrate", "choose"] },
        "previousHeads": { "$ref": "common.schema.json#/$defs/StepIdSet" },
        "proposedHeads": { "$ref": "common.schema.json#/$defs/StepIdSet" },
        "resultingHeads": { "$ref": "common.schema.json#/$defs/StepIdSet" },
        "divergenceCreated": { "type": "boolean" },
        "decisionProductObjectId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/ProductObjectId" }, { "type": "null" }]
        }
      }
    },
    "RepositoryViewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "outcome", "oldRepositoryViewId", "proposedRepositoryViewId", "newRepositoryViewId", "oldGeneration", "newGeneration", "layerResults", "eventId"],
      "properties": {
        "mutationId": { "$ref": "common.schema.json#/$defs/MutationId" },
        "outcome": { "type": "string", "enum": ["advanced", "integrated", "chosen", "mixed", "no_op"] },
        "oldRepositoryViewId": { "$ref": "common.schema.json#/$defs/RepositoryViewId" },
        "proposedRepositoryViewId": { "$ref": "common.schema.json#/$defs/RepositoryViewId" },
        "newRepositoryViewId": { "$ref": "common.schema.json#/$defs/RepositoryViewId" },
        "oldGeneration": { "type": "integer", "minimum": 0 },
        "newGeneration": { "type": "integer", "minimum": 0 },
        "layerResults": {
          "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
          "items": { "$ref": "#/$defs/LayerMutationResult" }
        },
        "eventId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/EventId" }, { "type": "null" }] }
      },
      "if": { "properties": { "outcome": { "const": "no_op" } }, "required": ["outcome"] },
      "then": { "properties": { "eventId": { "type": "null" } } },
      "else": { "properties": { "eventId": { "$ref": "common.schema.json#/$defs/EventId" } } }
    },
    "PolicyRootResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "outcome", "oldPolicySetId", "proposedPolicySetId", "newPolicySetId", "oldAuthorizationEpoch", "newAuthorizationEpoch", "eventId"],
      "properties": {
        "mutationId": { "$ref": "common.schema.json#/$defs/MutationId" },
        "outcome": { "type": "string", "enum": ["changed", "no_op"] },
        "oldPolicySetId": { "$ref": "common.schema.json#/$defs/ContentId" },
        "proposedPolicySetId": { "$ref": "common.schema.json#/$defs/ContentId" },
        "newPolicySetId": { "$ref": "common.schema.json#/$defs/ContentId" },
        "oldAuthorizationEpoch": { "type": "integer", "minimum": 1 },
        "newAuthorizationEpoch": { "type": "integer", "minimum": 1 },
        "eventId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/EventId" }, { "type": "null" }] }
      },
      "if": { "properties": { "outcome": { "const": "no_op" } }, "required": ["outcome"] },
      "then": { "properties": { "eventId": { "type": "null" } } },
      "else": { "properties": { "eventId": { "$ref": "common.schema.json#/$defs/EventId" } } }
    },
    "PolicyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "targetKind", "targetId", "allowed", "policyVersionObjectIds", "requiredProofObjectIds", "requiredGateEvaluationObjectIds"],
      "properties": {
        "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetKind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "allowed": { "type": "boolean" },
        "policyVersionObjectIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } },
        "requiredProofObjectIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } },
        "requiredGateEvaluationObjectIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } }
      }
    },
    "Rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalid_request", "missing_object", "missing_parent", "missing_file_manifest", "file_reconstruction_mismatch", "non_topological_steps", "non_topological_products", "duplicate_identity", "immutable_object_mismatch", "permission_denied", "policy_rejected", "gate_rejected", "invalid_view_mutation", "view_generation_conflict", "authorization_epoch_changed", "incompatible_version"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
