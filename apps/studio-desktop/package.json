{
  "name": "@layrs/studio-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Layrs Studio local-first desktop client.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6174",
    "tauri:dev": "cargo build --locked --manifest-path ../../Cargo.toml -p layrs-weave --bin layrs-lens-worker && tauri dev",
    "build": "vite build",
    "tauri:build": "cargo build --locked --release --manifest-path ../../Cargo.toml -p layrs-weave --bin layrs-lens-worker && tauri build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@layrs/ui": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
