{
  "name": "@layrs/lenses",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Built-in and installable Layrs lens runtime for React surfaces.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "check": "node scripts/implementation-digests.cjs --check && tsc --noEmit",
    "build": "node scripts/implementation-digests.cjs --check && tsc -p tsconfig.json",
    "test": "node scripts/implementation-digests.cjs --check && tsc -p tsconfig.test.json && node test/contract-golden.test.cjs",
    "update-digests": "node scripts/implementation-digests.cjs --write"
  },
  "dependencies": {
    "@layrs/lens-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
