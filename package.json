{
  "name": "layrs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first source control workspace for Layrs.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:apps": "pnpm --filter @layrs/studio-web build && pnpm --filter @layrs/studio-desktop build",
    "check": "node scripts/check-all.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:typescript": "pnpm -r --if-present check",
    "check:workspaces": "pnpm -r --if-present check",
    "dev": "node scripts/dev.mjs",
    "dev:services": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs",
    "dev:down": "node scripts/dev-down.mjs",
    "dev:info": "node scripts/dev.mjs --info",
    "dev:studio-web": "pnpm --filter @layrs/studio-web dev",
    "dev:studio-desktop": "pnpm --filter @layrs/studio-desktop tauri:dev",
    "format:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "migrations:append": "node scripts/check-migrations.mjs --append",
    "test": "node scripts/test-all.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:dev": "node scripts/test-local-dev.mjs",
    "test:rust": "node scripts/test-postgres.mjs --workspace",
    "test:postgres": "node scripts/test-postgres.mjs --server",
    "test:packages": "pnpm --filter @layrs/lens-sdk --filter @layrs/lenses test",
    "test:tauri": "cargo test --manifest-path apps/studio-desktop/src-tauri/Cargo.toml -- --test-threads=1",
    "test:desktop": "node scripts/playwright-run.mjs native visual",
    "test:desktop:ci": "node scripts/test-native-ui-ci.mjs desktop",
    "test:web:ci": "node scripts/test-native-ui-ci.mjs web",
    "test:desktop:debug": "node scripts/playwright-run.mjs native debug",
    "test:core": "node scripts/test-core.mjs",
    "test:scm-contracts": "node docs/contracts/scm-v1/verify-golden.mjs",
    "test:e2e:renderer": "node scripts/playwright-run.mjs renderer ci",
    "test:e2e:native": "node scripts/playwright-run.mjs native ci",
    "test:migrations:upgrade": "node scripts/test-migration-upgrade.mjs",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "ajv": "8.17.1"
  }
}
